<?xml version="1.0" encoding="utf-8" standalone="yes"?>

<!--
  Application Manifest for Windows 10/11
  Includes:
    - OS compatibility GUIDs
    - Common Controls v6
    - DPI awareness (Per-Monitor V2)
    - Long path support (>260 chars)
-->

<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">

  <!--
    Declare which Windows versions this application supports.
    These GUIDs are official Microsoft identifiers.
  -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows Vista / Server 2008 -->
      <supportedOS Id="{e2011457-1546-43c5-a5fe-008deee3d3f0}"/>
      <!-- Windows 7 / Server 2008 R2 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
      <!-- Windows 8 / Server 2012 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 8.1 / Server 2012 R2 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!--
    Execution level:
      asInvoker = no elevation, no UAC prompt
    uiAccess=false = cannot interact with secure desktop
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!--
    Enable modern visual styles (Common Controls v6)
    Required for proper rendering of many UI frameworks.
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="Win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"/>
    </dependentAssembly>
  </dependency>

  <!--
    Application-level Windows settings:
      - DPI awareness (True/PM = Per-Monitor V2)
      - Long path support (longPathAware=true)
    Namespace MUST be SMI/2016 for Win10/11 features.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">

      <!-- Per-monitor DPI awareness (best for multi-DPI setups) -->
      <dpiAware>true/PM</dpiAware>

      <!-- Enables paths >260 chars WITHOUT needing \\?\ prefix -->
      <longPathAware>true</longPathAware>

    </windowsSettings>
  </application>

</assembly>
